# ============================================================
# SALIN fail ini kepada ".env.local" (untuk dev tempatan) dan
# isikan nilai sebenar. JANGAN sesekali commit ".env.local" ke GitHub.
# Untuk Vercel: masukkan nilai yang sama di
# Project Settings -> Environment Variables.
# ============================================================

# --- Supabase ---
# Dapatkan di: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # RAHSIA - jangan expose ke frontend

# --- Stripe ---
# Dapatkan di: Stripe Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Dapatkan SELEPAS anda deploy & tambah webhook endpoint di
# Stripe Dashboard -> Developers -> Webhooks -> Add endpoint
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Admin (perlindungan asas untuk /api/admin/*) ---
# Tetapkan rentetan rawak yang panjang & rahsia sendiri.
# Nota: ini perlindungan MUDAH sahaja (shared secret), sesuai untuk
# projek kecil. Untuk sistem sebenar jangka panjang, gantikan dengan
# Supabase Auth + peranan admin.
ADMIN_API_SECRET=tukar-kepada-rentetan-rawak-anda-sendiri

# --- Notifikasi Automatik (Soalan Anda) ---
# EMEL: guna Gmail App Password (BUKAN kata laluan Gmail biasa).
# Cara dapatkan: myaccount.google.com/apppasswords (perlu 2-Step
# Verification diaktifkan dahulu di akaun Google anda)
GMAIL_USER=nurulyakinent25@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# WHATSAPP: guna servis percuma CallMeBot (untuk kegunaan peribadi).
# Cara dapatkan:
# 1. Simpan nombor +34 623 75 84 18 sebagai kenalan WhatsApp anda
# 2. Hantar mesej "I allow callmebot to send me messages" ke nombor tu
# 3. Tunggu balasan mengandungi APIKEY anda (dalam 2 minit)
CALLMEBOT_PHONE=60197635707
CALLMEBOT_APIKEY=xxxxxxx

# --- Site ---
# Selepas deploy ke Vercel, tukar kepada URL sebenar
# cth: https://tempahan-parking.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
